# Copia este fichero a .env y rellena los valores reales.
# .env nunca debe subirse a git (ver .gitignore).

DB_HOST=192.168.2.225
DB_NAME=Planificador
DB_USER=
DB_PASSWORD=

APP_BASE_URL=http://localhost:8090/
APP_ENV=development

# Rutas de subida de ficheros (antes hardcodeadas en Config/Core.php)
# *_PATH es la ruta física de escritura en disco.
# *_ALIAS es el prefijo de URL pública con el que el servidor web sirve esa
# misma carpeta (antes $alias_upload_cdmuelles = '/diskd/' y
# $alias_upload_firmas = '/diskd/Planificador/firmas/' en Config/Core.php).
# Ese alias lo debe resolver la configuración del servidor web (Apache/IIS),
# no el código: aquí solo se guarda el prefijo que se almacena en BD y se
# devuelve al cliente para pintar las imágenes.
UPLOADS_FIRMAS_PATH=./storage/uploads/firmas/
UPLOADS_FIRMAS_ALIAS=/uploads/firmas/
UPLOADS_CDMUELLES_PATH=./storage/uploads/cdmuelles/
UPLOADS_CDMUELLES_ALIAS=/uploads/cdmuelles/

# Host que sirve los alias de arriba. Déjalo vacío si el servidor web de la
# app también sirve esos alias (mismo host que APP_BASE_URL); indica un host
# distinto si, como en producción, "/diskd/" lo sirve otra máquina.
UPLOADS_HOST_URL=
