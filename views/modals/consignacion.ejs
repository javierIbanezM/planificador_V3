  // Función para verificar si se han realizado cambios en los campos
  function hayCambios(celdas) {
    for (var i = 0; i < celdas.length; i++) {
      if (celdas[i].textContent !== valoresOriginales[i]) {
        return true;
      }
    }
    return false;
  }

