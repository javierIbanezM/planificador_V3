  function cambiosonda() {
    const checkbox = document.getElementById('sonda');
    const isChecked = checkbox.checked ? 'activado' : 'desactivado';

    let formData = new FormData();
    formData.append('funcion', 'cambiosonda');
    formData.append('estado', isChecked); // Agregar estado al formData

    const options = {
      method: 'POST',
      body: formData,
    };

    fetch(baseUrl + 'api/consignacion.php', options)
      .then(response => {
        if (!response.ok) {
          throw new Error("Network response was not ok");
        }
        return response.json();
      })
      .then(data => {
        if (data.status === 'success') {
          Notificacion(data.Notificacion, data.Asunto, data.Message);
          // Reflejar el estado en el checkbox
          checkbox.checked = isChecked === 'activado';
        } else {
          // Si hubo un error, revertir el estado del checkbox
          checkbox.checked = !checkbox.checked;
          Notificacion(data.Notificacion, data.Asunto, data.Message);
        }
      })
      .catch(error => {
        console.error('Error en la solicitud:', error);
        // Revertir el estado si ocurre un error de red
        checkbox.checked = !checkbox.checked;
      });
  }


