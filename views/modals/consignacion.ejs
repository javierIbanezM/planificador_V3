          bellinactiva.style.display = 'block';
          bellactiva.style.display = 'none';
          Notificacion(data.Notificacion, data.Asunto, data.Message);
        } else {
          Notificacion(data.Notificacion, data.Asunto, data.Message);
        }
      })
  }

  function desagruparcddblclick() {
    // Mostrar confirmación antes de proceder
    if (!confirm("¿Estás seguro de que deseas desagrupar esta C/D?")) {
      return; // Si el usuario cancela, no se ejecuta el resto de la función
    }

    // Ya no hace falta marcar casillas en "Pedidos/Albaranes": el servidor
    // calcula solo qué expediciones/preavisos pertenecen a esta C/D
    // (idplanigrid activo en sesión) y desagrupa el grupo completo, para
    // no depender de que el usuario marque exactamente todas las filas
    // correctas (si faltaba alguna, el procedimiento abortaba en silencio
    // y antes esto igualmente mostraba "Operación exitosa").
    Notificacion('neutro', 'Proceso de desagrupación en Curso', 'Se está desagrupando la C/D, en cuanto termine saldrá confirmación.')
    var formData = new FormData();
    formData.append('funcion', 'desagruparcd');
    var options = {
      method: 'POST',
      body: formData,
    };
    fetch(baseUrl + 'api/consignacion.php', options)
      .then(response => response.json())
      .then(data => {
        Notificacion(data.Notificacion, data.Asunto, data.Message)
      })
  }

  function EliminarCD() {
    let formData = new FormData();
    formData.append('funcion', 'EliminarCD');
    const options = {
      method: 'POST',
      body: formData,
    };

    fetch(baseUrl + 'api/consignacion.php', options)
      .then(response => {
        if (!response.ok) {
          throw new Error("Network response was not ok");
        }
        return response.json();
      })
      .then(data => {
        if (data.status === 'success') {
          Notificacion(data.Notificacion, data.Asunto, data.Message);
        } else {
          Notificacion(data.Notificacion, data.Asunto, data.Message);
        }
      })
  }

