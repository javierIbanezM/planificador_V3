<script>
  // En caso que presionen intro en la cabecera o Esc
  document.addEventListener("DOMContentLoaded", function () {
    document.addEventListener("keydown", function (event) {
      if (btnguardar.style.visibility === "visible") {
        if (event.keyCode === 13) {
          event.preventDefault();
          btnguardar.click();
        }
        if (event.keyCode === 27) {
          event.preventDefault();
          btncerrar.click();
        }
      }
    });
  });


  // Declaramos variables para usarlas en los botones
  var btnedit = document.getElementById("btn-edit");
  var btnguardar = document.getElementById("btn-guardar");
  var btncerrar = document.getElementById("btn-cerrar");
  var tabla = document.getElementById("tablacab");
  var btnllegada = document.getElementById("btn-llegada");
  var btnsalida = document.getElementById("btn-salida");
  var btneliminamuelle = document.getElementById("btn-elimina-muelle");

  function mostraracciones() {
    botonmostraracciones = document.getElementById('btn-mostraracciones');
    divaccionesconsignacion = document.getElementById('divaccionesconsignacion');

    if (divaccionesconsignacion.style.display == 'none') {
      var formData = new FormData();
      formData.append('funcion', 'logsdblclickconsignacion');
      var options = {
        method: 'POST',
        body: formData,
      };
      fetch(baseUrl + 'api/consignacion.php', options)
        .then(response => response.json())
        .then(data => {
          var html = '';
          if (data == null) {
            html = '<tr><td style="text-align:center;" colspan="3">No existen acciones en esta C/D</td></tr>';
          } else {
            data.forEach(item => {
              var style = (item.instruccion === "DELETE") ? 'background-color: red; color: white;' : '';
              html += '<tr data-id="' + item.id + '" style="' + style + '">';
              html += '<td class="tablaplaning">' + item.fecha + '</td>';
              html += '<td class="tablaplaning" style="white-space: normal">' + item.descripcion + '</td>';
              html += '<td class="tablaplaning">' + item.usuario + '</td>';
              html += '</tr>';
            });
          };
          document.getElementById('bodytablaacciones').innerHTML = html;
        });
      divaccionesconsignacion.style.display = 'block';
    } else {
      divaccionesconsignacion.style.display = 'none';
    }
  }

  function mostrargaleria() {
    divgaleriaconsignacion = document.getElementById('divgaleriaconsignacion');

    if (divgaleriaconsignacion.style.display == 'none') {
      mostrarimagenesgaleria();
    } else {
      divgaleriaconsignacion.style.display = 'none';
    }
  }

  function mostrarimagenesgaleria() {
    let formData = new FormData();
    formData.append('funcion', 'galeriaconsignacion');
    const options = {
      method: 'POST',
      body: formData,
    };
    fetch(baseUrl + 'api/consignacion.php', options)
      .then(response => {
        if (!response.ok) {
          throw new Error("Network response was not ok");
        }
        return response.json();
      })
      .then(data => {
        if (data.status === 'success') {
          divgaleriaconsignacion.style.display = 'block';

          //botonmostrargaleria.innerText = 'Galería';

          // Limpiar el contenido actual del div antes de agregar las imágenes
          divgaleriaconsignacion.innerHTML = '<hr>';

          // Crear un contenedor para el scroll horizontal
          const scrollContainer = document.createElement('div');
          scrollContainer.style.overflowX = 'auto';
          scrollContainer.style.whiteSpace = 'nowrap';
          scrollContainer.style.textAlign = 'center';

          // Añadir el contenedor al div principal
          divgaleriaconsignacion.appendChild(scrollContainer);
          // Iterar sobre el array de imágenes y crear elementos para cada una
          data.images.forEach(image => {
            // Crear un contenedor para cada imagen
            const imageContainer = document.createElement('div');
            imageContainer.style.display = 'inline-block';
            imageContainer.style.position = 'relative'; // Añadir posición relativa al contenedor
            imageContainer.style.marginRight = '25px'; // Añadir margen derecho de 25px

            // Crear elementos HTML para mostrar la información de cada imagen
            let imgElement = document.createElement('img');
            imgElement.src = image.rutafichero;
            imgElement.alt = image.descripcion;
            imgElement.style.width = '150px';
            imgElement.style.display = 'block';

            // Añadir la imagen al contenedor
            imageContainer.appendChild(imgElement);

            // Agregar un contenedor para el botón de eliminar con fondo blanco redondo
            const deleteContainer = document.createElement('div');
            deleteContainer.style.position = 'absolute';
            deleteContainer.style.top = '5px';
            deleteContainer.style.right = '5px';
            deleteContainer.style.background = 'white';
            deleteContainer.style.borderRadius = '50%';
            deleteContainer.style.padding = '5px'; // Ajusta el padding según tus necesidades
            deleteContainer.setAttribute('id', image.id);
            deleteContainer.addEventListener('click', function () {
              eliminarFoto(image.id);
            });

            // Agregar el ícono de eliminar al contenedor del botón
            const deleteIcon = document.createElement('img');
            deleteIcon.src = baseUrl + 'assets/img/cerrar.png';
            deleteIcon.style.width = '20px'; // Ajusta el tamaño del ícono según tus necesidades
            deleteIcon.style.height = '20px';
            deleteIcon.style.cursor = 'pointer'; // Agregar un cursor de puntero para indicar que es interactivo

            // Agregar un contenedor para el botón de descarga con fondo blanco redondo
            const downloadContainer = document.createElement('div');
            downloadContainer.style.position = 'absolute';
            downloadContainer.style.top = '5px';
            downloadContainer.style.right = '40px';
            downloadContainer.style.background = 'white';
            downloadContainer.style.borderRadius = '50%';
            downloadContainer.style.padding = '5px'; // Ajusta el padding según tus necesidades
            downloadContainer.setAttribute('id', image.id);

            // Crear el ícono de descarga
            const downloadIcon = document.createElement('img');
            downloadIcon.src = baseUrl + 'assets/img/guardar.png';
            downloadIcon.style.width = '20px'; // Ajusta el tamaño del ícono según tus necesidades
            downloadIcon.style.height = '20px';
            downloadIcon.style.cursor = 'pointer'; // Agregar un cursor de puntero para indicar que es interactivo

            // Agregar un evento de clic al ícono de descarga
            downloadIcon.addEventListener('click', function () {
              // Descargar la imagen al hacer clic en el ícono
              const downloadLink = document.createElement('a');
              downloadLink.href = image.rutafichero; // Reemplaza con la ruta correcta a tu imagen
              downloadLink.download = image.id; // Reemplaza con el nombre que deseas para el archivo
              downloadLink.click();
              document.body.removeChild(downloadLink); // Eliminar el enlace después de la descarga
            });
            // Añadir el ícono de eliminar al contenedor del botón
            deleteContainer.appendChild(deleteIcon);
            imageContainer.appendChild(deleteContainer);

            downloadContainer.appendChild(downloadIcon);
            imageContainer.appendChild(downloadContainer);


            // Agregar elemento de texto debajo de cada foto
            const Textodescriptivo = document.createElement('p');
            Textodescriptivo.textContent = image.descripcion;
            Textodescriptivo.align = 'center';

            imageContainer.appendChild(Textodescriptivo);


            // Añadir el contenedor de la imagen al contenedor de scroll
            scrollContainer.appendChild(imageContainer);
          });


        } else if (data.status === 'no_images') {
          divgaleriaconsignacion.innerHTML = '';
          divgaleriaconsignacion.style.display = 'block';
          txtgaleria = document.createElement('h6');
          txtgaleria.className = 'modal-title';
          txtgaleria.innerText = 'Galería en la Carga/Descarga';
          divgaleriaconsignacion.appendChild(txtgaleria);

          Notificacion('info', 'No hay imágenes.', 'Aún no se han subido imágenes en la C/D')
        } else {
          Notificacion('error', 'Error en la consulta SQL: ', data.message);
        }
        fncontenedorsubidaimg();
      })
      .catch(error => {
        console.log('Error en la solicitud fetch: ', error);
      });
  }

  function mostrarQuizCalidad() {
    divquizcalidadconsignacion = document.getElementById('divquizcalidadconsignacion');

    if (divquizcalidadconsignacion.style.display == 'none') {
      cargarQuizCalidad();
    } else {
      divquizcalidadconsignacion.style.display = 'none';
    }
  }

  function cargarQuizCalidad() {
    let formData = new FormData();
    formData.append('funcion', 'datosquizcalidad');
    const options = {
      method: 'POST',
      body: formData,
    };
    fetch(baseUrl + 'api/consignacion.php', options)
      .then(response => {
        if (!response.ok) {
          throw new Error("Network response was not ok");
        }
        return response.json();
      })
      .then(data => {
        var html = '';
        var currentSection = '';
        data.forEach(item => {
          switch (item.tipo) {
            case 'sonda':
              if (item.sonda !== '') {
                html += '<tr question="' + item.id + '" tipocampo="' + item.tipo + '">';
                html += '<td style="padding:7px 0px 7px 2px;font-size:smaller;px;width:50%">' + item.campohtml + '</td>';
                html += '<td colspan="2" id="sonda" style="font-size:14px;width:25px;text-align:center">' + item.value + '</td>'
                html += '</tr>';
              }
              break;
            case 'precinto':
              if (item.precintocentralita !== '') {
                html += '<tr question="' + item.id + '" tipocampo="' + item.tipo + '">';
                html += '<td style="padding:7px 0px 7px 2px;font-size:smaller;px;width:50%">' + item.campohtml + '</td>';
