  // Función para validar los datos antes de enviarlos al servidor
  function validarDatos(celdas) {
    var hLlegada = celdas[4].textContent;
    var hSalida = celdas[5].textContent;
    var muelle = celdas[0].textContent;

    if (hLlegada !== '' && hSalida !== '' && muelle === '') {
      Notificacion('error', 'Error', 'No puedes asignar Salida de una C/D sin muelle.');
      return false;
    }
    if (hLlegada == '' && hSalida == '' && muelle !== '') {
      Notificacion('error', 'Error', 'Antes debes asignar llegada para luego asignar un muelle');
      return false;
    }

    return true;
  }


  // Función para enviar los datos al servidor
  function enviarDatosAlServidor() {
    var celdas = tabla.getElementsByTagName("td");
    if (!hayCambios(celdas)) {
      Notificacion('info', 'Cambios no actualizados', 'No realizó cambios en la cabecera, no se enviaron datos al servidor');
      edicionactiva = false;
      return;
    }
    var datosValidos = validarDatos(celdas);

    if (!datosValidos) {
      restaurarValoresOriginales(celdas)
      edicionactiva = false;
      return;
    }

    // Obtener los valores de los campos
    var muelle = celdas[0].textContent;
    var muelleReservado = celdas[1].textContent;
    var observacion = celdas[2].textContent;
    var fechaProgr = celdas[3].textContent;
    var hLlegada = celdas[4].textContent;
    var hSalida = celdas[5].textContent;
    var precinto = celdas[6].textContent;

    var data = {
      muelle,
      muelleReservado,
      observacion,
      fechaProgr,
      hLlegada,
      hSalida,
      precinto,
    };

    var jsonData = JSON.stringify(data);
    let formData = new FormData();
    formData.append('funcion', 'guardarcabeceramodal');
    formData.append('muelle', muelle);
    formData.append('muelleReservado', muelleReservado);
    formData.append('observacion', observacion);
    formData.append('fechaProgr', fechaProgr);
    formData.append('hLlegada', hLlegada);
    formData.append('hSalida', hSalida);
    formData.append('precinto', precinto);
    const options = {
      method: 'POST',
      body: formData,
    };

    fetch(baseUrl + 'api/consignacion.php', options)
      .then(response => {
        if (!response.ok) {
          throw new Error("Network response was not ok");
        }
        return response.json();
      })
      .then(data => {
        if (data.status === 'success') {
          Notificacion('correcto', 'Operación Exitosa', 'Cambios en cabecera realizados correctamente');
          var tbody = document.getElementById("bodytablacab");
          var dataId = tbody.getElementsByTagName("tr")[0];
          modal("consignacion", dataId);
        } else {
          Notificacion(data.status, data.status, data.Error);
          restaurarValoresOriginales(celdas);
        }
      })
      .catch(error => {
        Notificacion('error', 'Error', error.message);
      });
    edicionactiva = false;
  }

