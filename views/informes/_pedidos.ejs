<%
/**
 * Tabla "PEDIDOS CARGADOS / ALBARANES / Nº DE BULTOS" a dos columnas.
 * Réplica del bloque pedidos_pares/pedidos_impares de
 * HojaCarga1Renderer/HojaCarga2Renderer.
 */
const pares = pedidos.filter((_, i) => i % 2 === 0);
const impares = pedidos.filter((_, i) => i % 2 === 1);
const maxFilas = Math.max(pares.length, impares.length);
%>
<table style="table-layout:fixed">
  <colgroup>
    <col style="width:20.3%">
    <col style="width:13.3%">
    <col style="width:13.3%">
    <col style="width:6.3%">
    <col style="width:20.3%">
    <col style="width:13.3%">
    <col style="width:13.3%">
  </colgroup>
  <thead>
    <tr>
      <td class="bg-gris center bold">PEDIDOS CARGADOS</td>
      <td class="center bold">ALBARANES</td>
      <td class="center bold">Nº DE BULTOS</td>
      <td style="border-color:#fff"></td>
      <td class="bg-gris center bold">PEDIDOS CARGADOS</td>
      <td class="center bold">ALBARANES</td>
      <td class="center bold">Nº DE BULTOS</td>
    </tr>
  </thead>
  <tbody>
    <% for (let i = 0; i < maxFilas; i++) { %>
    <tr>
      <% if (pares[i]) { %>
      <td class="bg-gris center"><%= pares[i].pedido %></td>
      <td class="center"><%= pares[i].albaran %></td>
      <td class="center"><%= pares[i].bulto %></td>
      <td style="border-color:#fff"></td>
      <% } else { %>
      <td style="border-color:#fff"></td><td style="border-color:#fff"></td><td style="border-color:#fff"></td><td style="border-color:#fff"></td>
      <% } %>
      <% if (impares[i]) { %>
      <td class="bg-gris center"><%= impares[i].pedido %></td>
      <td class="center"><%= impares[i].albaran %></td>
      <td class="center"><%= impares[i].bulto %></td>
      <% } else { %>
      <td style="border-color:#fff"></td><td style="border-color:#fff"></td><td style="border-color:#fff"></td>
      <% } %>
    </tr>
    <% } %>
  </tbody>
</table>
