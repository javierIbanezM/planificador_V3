<!DOCTYPE html>
<html lang="es">

<head>
  <title><%= page %> - Planificador</title>
  <%- include('../partials/head-main') %>
</head>
<style>
    .menu-container {
      display: flex;
      height: 75vh;
      overflow-y: auto;
    }

    .sidebar {
      background-color: #f0f0f0;
      width: 5%;
      min-width: 150px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      border-radius: 10px;
      padding: 10px;
      overflow-y: auto;
    }

    .content {
      flex: 1;
      padding: 1%;
      margin-left: 0.5%;
      background-color: #f0f0f0;
      border-radius: 10px;
      overflow-y: auto;
    }

    .nav-link {
      text-decoration: none;
      color: #333;
      text-align: center;
    }

    .nav-item {
      padding: 10px 5px;
      width:100%;
      border-radius: 10px;
    }

    .nav-item svg {
      width: 100%;
      height: 25px;
    }

    .nav-item:hover {
      width:100%;
      cursor: pointer;
      background-color: #ddd;
      border-radius: 10px;
    }

  </style>
<body>

<%- include('../partials/header-muelles') %>
